{
  "$schema": "../shared/schemas/agent-config.schema.json",
  "schema_version": 1,
  "agent": {"name": "LZ Agent", "language": "pt-BR", "autonomy_level": 1},
  "localization": {
    "standard": "BCP 47", "default_locale": "pt-BR", "fallback_locale": "en",
    "auto_detect": true, "user_override": true, "rtl": true
  },
  "audio": {
    "stt": {"enabled": true, "provider": "auto", "local_preferred": true},
    "tts": {"enabled": true, "provider": "system", "voice": "auto", "rate": 1.0},
    "cloud_requires_explicit_consent": true,
    "clone_voice_requires_verified_consent": true
  },
  "providers": {
    "native": {"provider": "lz-agent", "model": "native-core-v1", "offline": true},
    "general": {"provider": "lz-agent", "model": "native-core-v1"},
    "coding": {"provider": "lz-agent", "model": "native-core-v1"},
    "external_providers_enabled": false
  },
  "internet": {"enabled": true, "requires_explicit_approval": true, "block_private_networks": true},
  "memory": {
    "backend": "sqlite", "project_memory": true, "lessons_learned": true,
    "action_ledger": true, "private_mode_retention": false,
    "retention": {"action_ledger_days": 365, "project_memory_days": null}
  },
  "database": {
    "local_file": "data/lz_agent.db", "migrations": true, "backup": true,
    "remote_sync": "disabled"
  },
  "ui": {"mode": "simple", "theme": "system", "animations": "reduced-when-requested"},
  "accessibility": {
    "screen_reader": "system", "captions": true, "keyboard_full_access": true,
    "voice_control": true, "switch_access": true
  },
  "safety": {
    "confirm_destructive_actions": true, "checkpoint_before_project_change": true,
    "rollback_on_failed_tests": true
  },
  "avatar": {"enabled": true, "render_mode": "auto", "fallback": "2d-static"}
}
